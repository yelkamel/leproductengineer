{
  "hosting": [
    {
      "target": "landing",
      "public": "apps/landing/out",
      "cleanUrls": true,
      "trailingSlash": true,
      "headers": [
        {
          "source": "/_next/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ]
    },
    {
      "target": "platform",
      "public": "apps/platform/out",
      "cleanUrls": true,
      "trailingSlash": true,
      "headers": [
        {
          "source": "/_next/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex"
            }
          ]
        }
      ]
    }
  ],
  "firestore": {
    "database": "(default)",
    "location": "europe-west1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true
    }
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Le Product Engineer",
        "supportEmail": "yelkamel@gmail.com",
        "authorizedRedirectUris": [
          "https://leproductengineer-go.web.app",
          "https://leproductengineer-93.firebaseapp.com"
        ]
      }
    }
  }
}
