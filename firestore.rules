rules_version = '2';

// Chaque apprenant ne lit et n'écrit que ses propres documents.
// Le contenu du programme est dans le code (packages/curriculum), pas en base.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function onlyKeys(keys) { return request.resource.data.keys().hasOnly(keys); }
    function isShortString(v, max) { return v is string && v.size() <= max; }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && onlyKeys(['displayName', 'email', 'createdAt', 'updatedAt'])
        && isShortString(request.resource.data.displayName, 120)
        && isShortString(request.resource.data.email, 320)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(uid)
        && onlyKeys(['displayName', 'email', 'createdAt', 'updatedAt'])
        && request.resource.data.createdAt == resource.data.createdAt
        && isShortString(request.resource.data.displayName, 120)
        && isShortString(request.resource.data.email, 320)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      // Une leçon terminée = un document dont l'id est l'id de la leçon.
      match /progress/{lessonId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && lessonId.size() <= 64
          && onlyKeys(['completedAt'])
          && request.resource.data.completedAt == request.time;
      }

      // La réponse à un exercice.
      match /submissions/{exerciseId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && exerciseId.size() <= 64
          && onlyKeys(['answer', 'checked', 'lessonId', 'updatedAt'])
          && isShortString(request.resource.data.answer, 10000)
          && request.resource.data.checked is list
          && request.resource.data.checked.size() <= 50
          && isShortString(request.resource.data.lessonId, 64)
          && request.resource.data.updatedAt == request.time;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
